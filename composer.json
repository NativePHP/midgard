{
    "name": "nativephp/midgard",
    "description": "Client library for native apps",
    "license": "proprietary",
    "authors": [
        {
            "name": "Simon Hamp",
            "email": "simon.hamp@me.com"
        }
    ],
    "require": {
        "php": "^8.0",
        "guzzlehttp/guzzle": "^7.3",
        "illuminate/database": "^7.0 | ^8.0",
        "illuminate/routing": "^7.0 | ^8.0",
        "illuminate/validation": "^7.0 | ^8.0",
        "league/oauth2-client": "^2.6",
        "lcobucci/jwt": "^4.1",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^8.5|^9.5",
        "pestphp/pest": "^1.21",
        "pestphp/pest-plugin-mock": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Native\\Api\\Client\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Native\\Api\\Client\\Tests\\": "tests"
        }
    },
    "repositories": [
    ],
    "extra": {
        "laravel": {
            "providers": [
                "Native\\Api\\Client\\ServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": [
            "./vendor/bin/pest"
        ]
    }
}
