{
    "name": "nativephp/midgard",
    "description": "Client library for native apps",
    "type": "nativephp-plugin",
    "license": "proprietary",
    "authors": [
        {
            "name": "Simon Hamp",
            "email": "simon.hamp@me.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-json": "*",
        "guzzlehttp/guzzle": "^7.9",
        "illuminate/auth": "^12.0|^13.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/routing": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/validation": "^12.0|^13.0",
        "lcobucci/jwt": "^5.3",
        "league/oauth2-client": "^2.7",
        "nativephp/mobile": "dev-idea/asgard"
    },
    "require-dev": {
        "laravel/pint": "^1.18",
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "Native\\Api\\Client\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Native\\Api\\Client\\Tests\\": "tests"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Native\\Api\\Client\\Asgard\\AsgardServiceProvider",
                "Native\\Api\\Client\\ServiceProvider"
            ]
        },
        "nativephp": {
            "manifest": "nativephp.json"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "test": "vendor/bin/pest",
        "format": "vendor/bin/pint"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/NativePHP/mobile-air"
        }
    ]
}
