{
  "namespace": "Asgard",
  "platforms": [
    "android",
    "ios"
  ],
  "bridge_functions": [
    {
      "name": "Asgard.Stream.Open",
      "android": "com.nativephp.plugins.asgard.AsgardStreamFunctions.Open",
      "ios": "AsgardStreamFunctions.Open",
      "description": "Open (or replace) a Server-Sent Events stream held by the native side"
    },
    {
      "name": "Asgard.Stream.Close",
      "android": "com.nativephp.plugins.asgard.AsgardStreamFunctions.Close",
      "ios": "AsgardStreamFunctions.Close",
      "description": "Close a Server-Sent Events stream and stop it reconnecting"
    }
  ],
  "android": {
    "permissions": [
      "android.permission.INTERNET"
    ],
    "min_version": 26,
    "dependencies": {
      "implementation": [
        "com.squareup.okhttp3:okhttp:4.12.0"
      ]
    }
  },
  "ios": {
    "info_plist": {
      "NSAppTransportSecurity": {
        "NSExceptionDomains": {
          "test": {
            "NSIncludesSubdomains": true,
            "NSExceptionAllowsInsecureHTTPLoads": true
          }
        }
      }
    },
    "dependencies": {
      "swift_packages": [],
      "pods": []
    },
    "min_version": 17.0
  },
  "events": [
    "Native\\Api\\Client\\Asgard\\Events\\StreamMessage",
    "Native\\Api\\Client\\Asgard\\Events\\StreamOpened",
    "Native\\Api\\Client\\Asgard\\Events\\StreamClosed"
  ]
}
